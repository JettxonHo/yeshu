# ============================================================
# 野薯(Yeshu)· 环境变量模板(.env.example)
# ------------------------------------------------------------
# 用法:cp .env.example .env,然后填入真实值。
# 铁律:本文件是模板(可 commit),真实的 .env 绝不 commit(见 .gitignore)。
#       代码只读环境变量,不硬编码任何密钥。
# ============================================================

# ---------- GitHub(任务数据真相源:Projects V2 GraphQL)----------
# Classic Token,scope 需含 project + repo。
# 注意:必须用 Classic Token —— Fine-grained PAT 不支持用户级 Projects V2。
GITHUB_TOKEN=xxx
# 你的 GitHub 用户名
GITHUB_LOGIN=xxx
# Projects V2 编号(项目 URL 里的数字)
GITHUB_PROJECT_NUMBER=xxx

# ---------- 飞书(内容真相源 + 推送目标)----------
LARK_APP_ID=xxx
LARK_APP_SECRET=xxx
# 私聊推送(V0:推给自己)
LARK_OPEN_ID=xxx
# 群推送(V1+:推到朋友群;V0 注释掉不用)
# LARK_CHAT_ID=xxx
# 事件订阅 Verification Token(生产必配,webhook 校验用;飞书后台「事件与回调」取)
LARK_VERIFICATION_TOKEN=xxx

# ---------- AI(OpenAI 兼容抽象,可切换 provider)----------
# provider 选择:deepseek / claude / openai(MVP 默认 deepseek)
AI_PROVIDER=xxx
# 例:https://api.deepseek.com/v1
AI_BASE_URL=xxx
# 例:deepseek-chat
AI_MODEL=xxx
AI_API_KEY=xxx

# ---------- 阿里云 FC 部署 ----------
# 部署凭证(子用户 AccessKey)用 `s config add` 存到 ~/.s/access.yaml,不放此处。
# 上面所有变量经 worker/s.yaml 的 environmentVariables(${env(KEY)})注入 FC 函数。

# ---------- 幂等后端(Tablestore,防飞书重复投递导致重复建卡/重复状态转换)----------
# 生产必须为 tablestore(缺失或其他值,FC 冷启动直接失败;不允许静默回退内存后端)。
# 本地开发入口(index.ts)固定使用内存后端,不读取下面任何 TABLESTORE_* 变量。
# 启用前置(人工准备,Worker 不建表、不改 Schema、不建 RAM 身份):
#   见 docs/runbooks/idempotency-tablestore.md
IDEMPOTENCY_BACKEND=tablestore
# 幂等 claim 逻辑 TTL(秒)。默认 604800(7 天);表级 TTL 只做长期清理。
IDEMPOTENCY_TTL_SECONDS=604800
# Tablestore 实例连接信息(不要使用主账号 AccessKey):
TABLESTORE_ENDPOINT=xxx
TABLESTORE_INSTANCE_NAME=xxx
TABLESTORE_TABLE_NAME=xxx
# 必须使用专用最小权限 RAM 身份的 AccessKey(仅该表的 GetRow/PutRow/UpdateRow/DeleteRow);
# 严禁使用阿里云主账号 AccessKey。凭证经 s.yaml 透传注入 FC,不进 git。
TABLESTORE_ACCESS_KEY_ID=xxx
TABLESTORE_ACCESS_KEY_SECRET=xxx
# 可选:STS 临时凭证 token(使用 STS 时配置;长期 AK 场景留空)
# TABLESTORE_STS_TOKEN=xxx
